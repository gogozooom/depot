<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Frogstore" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Depot">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/images/icon.png" type="image/png">
    <link rel="icon" href="/images/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/images/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="flex justify-between bg-blue-800">
      <a href="/"><%= image_tag 'logo-green.svg', alt: 'The Pragmatic Bookshelf', class: 'p-4' %></a>
      <div class="p-4" data-controller="locale">
        <%= form_with url: store_index_path, class: 'locale' do %>
          <%= select_tag 'set_locale',
            options_for_select(LANGUAGES, I18n.locale.to_s),
            class: 'text-white bg-blue-800',
            onchange: 'this.form.submit()' %>          
          <%= submit_tag 'submit', data: {'locale-target' => 'submit'} %>
        <% end %>
      </div>
    </header>
    <section class="flex">
      <nav class="bg-blue-900 p-6">

        <ul class="text-gray-300 leading-8">
          <li><%= link_to t('.home'), store_index_url(locale: I18n.locale) %></li>
          <li class="hidden"><a href="/questions"><%= t('.questions') %></a></li>
          <li class="hidden"><a href="/news"><%= t('.news') %></a></li>
          <li class="hidden"><a href="/contact"><%= t('.contact') %></a></li>
        </ul>

        <hr class="my-2">

        <ul class="text-gray-300 leading-8">
        <% if authenticated? %>
          <li><%= link_to 'Orders', orders_path(locale: I18n.locale) %></li>
          <li><%= link_to 'Products', products_path(locale: I18n.locale) %></li>
          <li><%= link_to 'Users', users_path(locale: I18n.locale) %></li>
          <li><%= button_to t('.logout'), session_path(locale: I18n.locale), method: :delete %></li>
        <% else %>
          <li><%= link_to t('.login'), new_session_path(locale: I18n.locale) %></li>
        <% end %>

        <%= render partial: 'layouts/cart', locals: { cart: @cart } %>
      </nav>

      <main class="container mx-auto mt-4 px-5 flex">
        <%= yield %>
      </main>
    </section>
  </body>
</html>
